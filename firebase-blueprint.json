{
  "entities": {
    "StudentProfileDoc": {
      "title": "StudentProfileDoc",
      "description": "Stores student profile, progress, points, badges, daily challenge lock state, and Nafes stages completed.",
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "description": "Unique student identifier (name_code)",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-\\u0600-\\u06FF\\s]+$"
        },
        "name": {
          "type": "string",
          "description": "Student full name in Arabic",
          "minLength": 1,
          "maxLength": 80
        },
        "code": {
          "type": "string",
          "description": "4-digit student pin code",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "cls": {
          "type": "string",
          "description": "Classroom section (أ, ب, ج)",
          "minLength": 1,
          "maxLength": 10
        },
        "points": {
          "type": "number",
          "description": "Total points earned by student"
        },
        "badges": {
          "type": "array",
          "description": "List of earned badge names (bounded up to 40)"
        },
        "correct": {
          "type": "number",
          "description": "Total correct answers across quizzes"
        },
        "attempts": {
          "type": "number",
          "description": "Total quiz attempts"
        },
        "progress": {
          "type": "number",
          "description": "Overall journey progress percentage (0-100)"
        },
        "completed": {
          "type": "array",
          "description": "Titles of completed lessons and exams (bounded up to 50)"
        },
        "nafesStageIndex": {
          "type": "number",
          "description": "Index of current Nafes exam stage reached"
        },
        "dailyCurrentIndex": {
          "type": "number",
          "description": "Index of current unlocked daily challenge question"
        },
        "dailyNextUnlockMs": {
          "type": "number",
          "description": "Timestamp in ms when the next daily challenge unlocks"
        },
        "lastQuizTitle": {
          "type": "string",
          "description": "Title of last completed exam",
          "maxLength": 120
        },
        "lastQuizScore": {
          "type": "number",
          "description": "Score in last completed exam"
        },
        "lastQuizTotal": {
          "type": "number",
          "description": "Total questions in last completed exam"
        },
        "isBlocked": {
          "type": "boolean",
          "description": "Whether student profile is paused/restricted by admin"
        },
        "raceCompletedAt": {
          "type": "number",
          "description": "Timestamp ms when race completion was reached"
        },
        "finishLineReached": {
          "type": "boolean",
          "description": "Whether student reached finish gate requirements"
        },
        "scoredQuestions": {
          "type": "array",
          "description": "Ledger of scored question identifiers to prevent repeat scoring"
        },
        "completedNafesStages": {
          "type": "array",
          "description": "List of completed Nafes stages ids"
        },
        "registeredAt": {
          "type": "number",
          "description": "First recorded registration or login timestamp ms"
        },
        "lastActiveAt": {
          "type": "number",
          "description": "Latest heartbeat or activity timestamp ms"
        },
        "sessionCount": {
          "type": "number",
          "description": "Total count of student visits and sessions"
        },
        "gradeLevel": {
          "type": "string",
          "description": "Academic grade level (e.g. الأول المتوسط)",
          "maxLength": 50
        },
        "lastActivityType": {
          "type": "string",
          "description": "Category of student's latest activity",
          "maxLength": 60
        },
        "updatedAt": {
          "type": "number",
          "description": "Client/server epoch ms of last update"
        }
      },
      "required": [
        "profileId",
        "name",
        "code",
        "cls",
        "points",
        "correct",
        "attempts",
        "progress",
        "nafesStageIndex",
        "dailyCurrentIndex",
        "dailyNextUnlockMs",
        "updatedAt"
      ]
    },
    "CustomChallengeDoc": {
      "title": "CustomChallengeDoc",
      "description": "Custom daily challenge question added or edited by the teacher/admin.",
      "type": "object",
      "properties": {
        "day": {
          "type": "number",
          "description": "Day number in the progression"
        },
        "level": {
          "type": "string",
          "description": "Difficulty level label",
          "minLength": 2,
          "maxLength": 40
        },
        "points": {
          "type": "number",
          "description": "Points awarded for solving"
        },
        "unitTopic": {
          "type": "string",
          "description": "Unit and grammar rule topic",
          "minLength": 2,
          "maxLength": 120
        },
        "question": {
          "type": "string",
          "description": "Question prompt",
          "minLength": 4,
          "maxLength": 500
        },
        "options": {
          "type": "array",
          "description": "4 multiple choice options"
        },
        "answer": {
          "type": "number",
          "description": "Correct option index (0-3)"
        },
        "explanation": {
          "type": "string",
          "description": "Grammar explanation",
          "minLength": 2,
          "maxLength": 500
        },
        "authorEmail": {
          "type": "string",
          "description": "Admin email who created it",
          "maxLength": 120
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp ms"
        }
      },
      "required": [
        "day",
        "level",
        "points",
        "unitTopic",
        "question",
        "options",
        "answer",
        "explanation",
        "authorEmail",
        "createdAt"
      ]
    },
    "AppSettingsDoc": {
      "title": "AppSettingsDoc",
      "description": "Global application settings, announcements, scheduling, unit locks, games locks, and Nafes stages permissions controlled by teacher.",
      "type": "object",
      "properties": {
        "announcement": {
          "type": "string",
          "description": "Announcement banner message from teacher to students",
          "maxLength": 400
        },
        "enforce24hChallengeLock": {
          "type": "boolean",
          "description": "When true, next daily challenge only opens 24h after solving the current one"
        },
        "enableGames": {
          "type": "boolean",
          "description": "Master permission toggle to enable or disable language games center"
        },
        "enableNafes": {
          "type": "boolean",
          "description": "Master permission toggle to enable or disable Nafes national exams"
        },
        "enableFeedback": {
          "type": "boolean",
          "description": "Permission toggle to enable or disable parent feedback"
        },
        "adminPin": {
          "type": "string",
          "description": "Teacher quick access PIN",
          "minLength": 4,
          "maxLength": 12
        },
        "platformManualStatus": {
          "type": "string",
          "description": "Manual platform status override ('open' or 'closed')",
          "maxLength": 20
        },
        "scheduleEnabled": {
          "type": "boolean",
          "description": "Whether automated time scheduling is active or manual control is in effect"
        },
        "scheduledOpenAt": {
          "type": "string",
          "description": "Scheduled opening ISO / datetime-local string",
          "maxLength": 50
        },
        "scheduledCloseAt": {
          "type": "string",
          "description": "Scheduled closing ISO / datetime-local string",
          "maxLength": 50
        },
        "scheduleNote": {
          "type": "string",
          "description": "Custom note regarding operating schedule",
          "maxLength": 200
        },
        "unit1Open": {
          "type": "boolean",
          "description": "Permission toggle for Unit 1"
        },
        "unit2Open": {
          "type": "boolean",
          "description": "Permission toggle for Unit 2"
        },
        "unit3Open": {
          "type": "boolean",
          "description": "Permission toggle for Unit 3"
        },
        "orderUnit1Open": {
          "type": "boolean",
          "description": "Permission toggle for Order Game Unit 1"
        },
        "orderUnit2Open": {
          "type": "boolean",
          "description": "Permission toggle for Order Game Unit 2"
        },
        "orderUnit3Open": {
          "type": "boolean",
          "description": "Permission toggle for Order Game Unit 3"
        },
        "orderUnlockAll": {
          "type": "boolean",
          "description": "Teacher master bypass for all order units"
        },
        "gameDetectiveOpen": {
          "type": "boolean",
          "description": "Permission toggle for Detective game"
        },
        "gameOrderOpen": {
          "type": "boolean",
          "description": "Permission toggle for Order Sentence game"
        },
        "gameMeaningOpen": {
          "type": "boolean",
          "description": "Permission toggle for Vocabulary Meaning game"
        },
        "gameSpeedOpen": {
          "type": "boolean",
          "description": "Permission toggle for Speed Challenge game"
        },
        "nafesStage1Open": {
          "type": "boolean",
          "description": "Permission toggle for Nafes Stage 1"
        },
        "nafesStage2Open": {
          "type": "boolean",
          "description": "Permission toggle for Nafes Stage 2"
        },
        "nafesStage3Open": {
          "type": "boolean",
          "description": "Permission toggle for Nafes Stage 3"
        },
        "nafesStage4Open": {
          "type": "boolean",
          "description": "Permission toggle for Nafes Stage 4"
        },
        "tickerCustomText": {
          "type": "string",
          "description": "Custom teacher broadcast message in race ticker",
          "maxLength": 500
        },
        "tickerAnnouncements": {
          "type": "array",
          "description": "List of structured teacher announcements for race ticker"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp ms of last config update"
        }
      },
      "required": [
        "announcement",
        "enforce24hChallengeLock",
        "enableGames",
        "enableNafes",
        "enableFeedback",
        "adminPin",
        "updatedAt"
      ]
    },
    "FeedbackDoc": {
      "title": "FeedbackDoc",
      "description": "Parent or student feedback item stored in Firestore with moderation status.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "description": "Sender role",
          "minLength": 2,
          "maxLength": 50
        },
        "cls": {
          "type": "string",
          "description": "Classroom section",
          "minLength": 1,
          "maxLength": 30
        },
        "text": {
          "type": "string",
          "description": "Feedback content",
          "minLength": 2,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Moderation status",
          "minLength": 2,
          "maxLength": 40
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp ms"
        }
      },
      "required": [
        "role",
        "cls",
        "text",
        "status",
        "createdAt"
      ]
    },
    "ParentMessageDoc": {
      "title": "ParentMessageDoc",
      "description": "Confidential communication message between parent/student and the teacher.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "studentCls": { "type": "string", "maxLength": 40 },
        "category": { "type": "string", "maxLength": 60 },
        "text": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "number" },
        "replyText": { "type": "string", "maxLength": 1000 },
        "replyAt": { "type": "number" },
        "teacherName": { "type": "string", "maxLength": 100 }
      },
      "required": [
        "studentId",
        "studentName",
        "studentCls",
        "category",
        "text",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentProfileDoc" },
      "description": "Student progress, points, horse race leaderboard ranking, 24h daily challenge lock, and Nafes stage."
    },
    "/custom_challenges/{challengeId}": {
      "schema": { "$ref": "#/entities/CustomChallengeDoc" },
      "description": "Teacher-added custom daily challenges."
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettingsDoc" },
      "description": "Global application settings and permissions controlled by the teacher."
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/FeedbackDoc" },
      "description": "Parent suggestions and feedback with admin approval."
    },
    "/parent_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ParentMessageDoc" },
      "description": "Parent and teacher private messages."
    }
  }
}
